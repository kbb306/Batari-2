     13  10000 ????		00 d7	    qtcontroller =	d
     14  10000 ????
     15  10000 ????		00 ed	    TextIndex  =	z
     16  10000 ????
     17  10000 ????		00 d5	    index      =	b
     18  10000 ????
     19  10000 ????		00 d4	    BaudByte   =	a
     20  10000 ????
