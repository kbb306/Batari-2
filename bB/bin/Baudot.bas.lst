   1873  f9ff
   1874  f9ff							; feel free to modify the score graphics - just keep each digit 8 high
   1875  f9ff							; and keep the conditional compilation stuff intact
   1876  f9ff				  -	      ifconst	ROM2k
   1877  f9ff				  -	      ORG	$F7AC-8
   1878  f9ff					      else
   1879  f9ff				  -	      ifconst	bankswitch
   1880  f9ff				  -	      if	bankswitch == 8
   1881  f9ff				  -	      ORG	$2F94-bscode_length
   1882  f9ff				  -	      RORG	$FF94-bscode_length
   1883  f9ff				  -	      endif
   1884  f9ff				  -	      if	bankswitch == 16
   1885  f9ff				  -	      ORG	$4F94-bscode_length
   1886  f9ff				  -	      RORG	$FF94-bscode_length
   1887  f9ff				  -	      endif
   1888  f9ff				  -	      if	bankswitch == 32
   1889  f9ff				  -	      ORG	$8F94-bscode_length
   1890  f9ff				  -	      RORG	$FF94-bscode_length
   1891  f9ff				  -	      endif
   1892  f9ff				  -	      if	bankswitch == 64
   1893  f9ff				  -	      ORG	$10F80-bscode_length
   1894  f9ff				  -	      RORG	$1FF80-bscode_length
   1895  f9ff				  -	      endif
   1896  f9ff					      else
   1897  ff9c					      ORG	$FF9C
   1898  ff9c					      endif
   1899  ff9c					      endif
   1900  ff9c
