      9  10000 ????		00 d7	    ColNum     =	d
     10  10000 ????
     11  10000 ????		00 d6	    RowNum     =	c
     12  10000 ????
     13  10000 ????		00 d5	    rand16     =	b
     14  10000 ????
     15  10000 ????		00 d4	    qtcontroller =	a
     16  10000 ????
