   2588  7081							;----------------------------------------
   2589  7081							; Display Data
   2590  7081							;----------------------------------------
   2591  7081							; The Display Data bank is copied into RAM when DPC+ initializes the cartridge.
   2592  7081							; This allows us to manipulate the data during run-time, but have a known
   2593  7081							; starting state when the Atari is first turned on.
   2594  7081							;
   2595  7081							; Unlike normal Atari VCS/2600 sprite definitions, the sprite data in the
   2596  7081							; Display Data bank is stored right-side-up.
   2597  7081							;
   2598  7081							;----------------------------------------
   2599  7081
   2600  7081				   Zeros32
   2601  7081		       00 84	   SOUND_OFF  =	(* & $1fff)/32
   2602  7081				   DisplayDataDigitBlank
   2603  7081		       00		      .byte.b	0	;--
   2604  7082		       00		      .byte.b	0	;--
   2605  7083		       00		      .byte.b	0	;--
   2606  7084		       00		      .byte.b	0	;--
   2607  7085		       00		      .byte.b	0	;--
   2608  7086		       00		      .byte.b	0	;--
   2609  7087		       00		      .byte.b	0	;--
   2610  7088		       00		      .byte.b	0	;--
   2611  7089
   2612  7089							;	align 32
   2613  7089							;Zeros32:
